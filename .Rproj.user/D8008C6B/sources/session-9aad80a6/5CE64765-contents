## Uncertainty including internal variability (test)

```{r internal-var, fig.width = 12, fig.height = 11}
# Internal variability: mean variance of the spline residuals across runs (Hawkins & Sutton 2009, Eq. 4; Reum et al. 2020, Eq. 4)
vint <- read.csv(file.path(outputDir, "internal_variability.csv"))
names(vint)[1] <- "species"

# Internal variability for each year: constant over 2015-2099 (V, Hawkins & Sutton 2009) or by time block (V0, V1, V2, Reum et al. 2020)
int_year <- expand.grid(species = 1:12, Year = 1:85) |>
  left_join(vint, by = "species") |>
  mutate(V_block = case_when(Year <= 26 ~ V0, Year <= 66 ~ V1, TRUE ~ V2))

# Total variance = MEM + ESM + SSP + internal (Hawkins & Sutton 2009, Eq. 7); % of each source per year
pc_internal <- function(int_col) {
  test |>
    mutate(VarComp = as.character(VarComp)) |>
    bind_rows(int_year |> transmute(species, VarComp = "Internal", Year, value = .data[[int_col]])) |>
    group_by(species, Year) |>
    mutate(percent = value/sum(value)*100) |>
    ungroup()
}
var_int_HS <- pc_internal("V")
var_int_block <- pc_internal("V_block")

# Mean % per source across groups and years
bind_rows(var_int_HS |> mutate(method = "V constant"), var_int_block |> mutate(method = "V by time block")) |>
  group_by(method, VarComp) |>
  summarise(percent = round(mean(percent), 1), .groups = "drop")

varPalette_int <- c(varPalette, Internal = "palegreen3")
plot_internal <- function(df) {
  df |>
    ggplot(aes(fill=VarComp, y=percent, x=Year)) +
    geom_area(position = "stack", alpha = 0.7) +
    facet_wrap(~species, scale="free", ncol =3, labeller = labeller(species = c("1" = "Phytoplankton","2" = "Zooplankton", "3" = "Mesopelagics", "4" = "Cephalopods", "5" = "Sharks","6" = "Seabirds", "7" =  "Macrobenthos", "8" = "Small pelagics", "9" = "Hakes", "10" = "Demersals", "11" = "Large pelagics", "12" = "Marine mammals"))) +
    scale_x_continuous(expand = c(0, 0)) +
    scale_y_continuous(expand = c(0, 0)) +
    scale_fill_manual(values=varPalette_int) +
    ylab("Uncertainty (%)") + labs(fill='') + theme_bw() +
    theme(plot.background = element_blank(), panel.grid.minor = element_blank(), panel.grid.major = element_blank(), legend.position = "bottom")
}

fig6_int_HS <- plot_internal(var_int_HS)
fig6_int_block <- plot_internal(var_int_block)
fig6_int_HS
fig6_int_block
ggsave(file.path(figDir, "Fig6_internal_constant.pdf"), fig6_int_HS, height = 11, width = 12)
ggsave(file.path(figDir, "Fig6_internal_blocks.pdf"), fig6_int_block, height = 11, width = 12)
```


