## Uncertainty percentages and Fig 6

```{r fig6, fig.width = 12, fig.height = 11}
# Convert uncertainty values per source into %s of the total uncertainty, and calculate a rolling mean to smooth the contributions by the different uncertainty sources

var_centered_pc <- test |>
  group_by(species, Year)|>
  mutate(total_var = sum(value)) |>
  mutate(percent = value/total_var*100) |>
  group_by(species, VarComp)|>
  mutate(r_mean = rollmean(percent, k = 10, fill = NA, align = "right")) #may need to change align to left to get values from the start of the ts

#Saving uncertainty partition %s dataset
write_csv(var_centered_pc,paste0(outputDir,"/uncertainty_partitition_sBenguela_centered_percent.csv"))
var_centered_pc <- read_csv(paste0(outputDir,"/uncertainty_partitition_sBenguela_centered_percent.csv"))

#Plot of uncertainty sources by functional group (REV: 6a and 6b combined in one figure, R1)
fig6 <- var_centered_pc |>
  ggplot(aes(fill=VarComp, y=percent, x=Year)) +
  geom_area(position = "stack", alpha = 0.7) +
  facet_wrap(~species, scale="free", ncol =3, labeller = labeller(species = c("1" = "Phytoplankton","2" = "Zooplankton", "3" = "Mesopelagics", "4" = "Cephalopods", "5" = "Sharks","6" = "Seabirds", "7" =  "Macrobenthos", "8" = "Small pelagics", "9" = "Hakes", "10" = "Demersals", "11" = "Large pelagics", "12" = "Marine mammals"))) +
  scale_x_continuous(expand = c(0, 0)) +
  scale_y_continuous(expand = c(0, 0)) +
  scale_fill_manual(values=varPalette) +
  ylab("Uncertainty (%)") + labs(fill='') + theme_bw() +
  theme(plot.background = element_blank(), panel.grid.minor = element_blank(), panel.grid.major = element_blank(), legend.position = "bottom")

fig6
