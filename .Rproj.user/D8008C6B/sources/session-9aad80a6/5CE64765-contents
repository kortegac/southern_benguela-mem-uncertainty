# Function to calculate variance. The analysis first uses all the data for all 85 years to fit the regression, only then the var is calculated by year update function based on Jon's feedback
```{r computejon}
ComputeJon <- function(Heads,Dat1,Nspec,Yr1=1,Yr2=85)
{
  Dat2 <- Dat1[Yr1:Yr2,]; Yrs <- Yr1:Yr2; Nyr <- length(Yrs)
  Nspec <- length(unique(as.numeric(Heads[1,])))
  Nmodel <- length(unique(as.numeric(Heads[2,])))
  NESM <- length(unique(as.numeric(Heads[3,])))
  NSSP <- length(unique(as.numeric(Heads[4,])))

 VarOut <- array(0,dim=c(Nspec,3,Nyr), dimnames=list(species=1:Nspec, VarComp=c("MEM","ESM","SSP"), Year=1:Nyr))
 VarInt <- array(0,dim=c(Nspec,4), dimnames=list(species=1:Nspec, VarComp=c("V","V0","V1","V2")))

  # Loop over species
  for (Ispec in 1:Nspec)
  {
    Obs <- array(0,dim=c(Nmodel,NESM,NSSP,Nyr))
    Poly <- array(0,dim=c(Nmodel,NESM,NSSP,Nyr))
    Resid <- array(0,dim=c(Nmodel,NESM,NSSP,Nyr))
    Models <- which(Heads[1,]==Ispec)
    Nrun <- length(Models)
    ModelW <- 1/Nrun; V <- 0 ; V1 <-0; V2<-0; V0 <-0

    Vvec<- rep(0, Nrun)

    #Get polynomial trends
    for (II in 1:Nrun)
    {
      Imodel <- Heads[2,Models[II]]
      Iesm <- Heads[3,Models[II]]
      Issp <- Heads[4,Models[II]]
      yobs <- Dat2[,Models[II]]
      lm1 <-  gam(yobs~s(Yrs, k=4)) #and just fit a spline like in Reum et al. 2020
      Pred <- predict((lm1))
      Poly[Imodel,Iesm,Issp,] <- Pred
      Obs[Imodel,Iesm,Issp,] <- yobs
      Resid[Imodel,Iesm,Issp,] <- yobs - Pred
      #Internal var 2015-2099 (all years, as in Hawkins & Sutton)
      V <- V + ModelW*var(Resid[Imodel,Iesm,Issp,])
    
      V0 <- V0 + ModelW*var(Resid[Imodel,Iesm,Issp,1:26])   # corresponds to 2015-2040 as in Reum et al 2020

      V1 <- V1 + ModelW*var(Resid[Imodel,Iesm,Issp,27:66])

      V2 <- V2 + ModelW*var(Resid[Imodel,Iesm,Issp,67:85])
    }

    MuT <- rep(0,Nyr); VarT <- rep(0,Nyr)
    MuMod <- rep(0,Nyr); VarMod <- rep(0,Nyr)
    MuESM <- rep(0,Nyr); VarESM <- rep(0,Nyr)
    MuSSP <- rep(0,Nyr); VarSSP <- rep(0,Nyr)
    AlphaMod <- matrix(0,nrow=Nmodel,ncol=Nyr)
    AlphaESM <- matrix(0,nrow=NESM,ncol=Nyr)
    AlphaSSP <- matrix(0,nrow=NSSP,ncol=Nyr)

    # Loop through each year and calculate variance on trends for model, ESM, SSP
    for (Iy in 1:Nyr)
    {
      yvals <- NULL; xvals1 <- NULL; xvals2 <- NULL; xvals3 <- NULL
      for (Imodel in 1:Nmodel)
       for (IESM in 1:NESM)
        for (ISSP in 1:NSSP)
         {
          yvals <- c(yvals,Poly[Imodel,IESM,ISSP,Iy])
          xvals1 <- c(xvals1,Imodel)
          xvals2 <- c(xvals2,IESM)
          xvals3 <- c(xvals3,ISSP)
        }

      MuT[Iy] <- mean(Poly[,,,Iy])
      VarT[Iy] <- sum((as.vector(Poly[,,,Iy]-mean(Poly[,,,Iy])))^2)/(Nmodel*NESM*NSSP)

      if (Nmodel > 1)
       {
        for (Imodel in 1:Nmodel)
         AlphaMod[Imodel,Iy] <- mean(Poly[Imodel,,,Iy])-mean(Poly[,,,Iy])
         VarMod[Iy] <- sum((as.vector(AlphaMod[,Iy]))^2)/Nmodel
        }
      if (NESM>1)
       {
        for (IESM in 1:NESM)
        AlphaESM[IESM,Iy] <- mean(Poly[,IESM,,Iy])-mean(Poly[,,,Iy])
        VarESM[Iy] <- sum((as.vector(AlphaESM[,Iy]))^2)/NESM
      }
      if (NSSP>1)
       {
        for (ISSP in 1:NSSP)
        AlphaSSP[ISSP,Iy] <- mean(Poly[,,ISSP,Iy])-mean(Poly[,,,Iy])
        VarSSP[Iy] <- sum((as.vector(AlphaSSP[,Iy]))^2)/NSSP
      }
        }
    VarOut[Ispec,1,] <- VarMod
    VarOut[Ispec,2,] <- VarESM
    VarOut[Ispec,3,] <- VarSSP
    VarInt[Ispec,1] <- V
    VarInt[Ispec,2] <- V0
    VarInt[Ispec,3] <- V1
    VarInt[Ispec,4] <- V2

  } # Nspec
  write.csv(VarInt, file.path(outputDir, "internal_variability.csv")) # V (2015-2099), V0 (2015-2040), V1 (2041-2080), V2 (2081-2099)
  print(VarInt)
  return(VarOut)

}
```

