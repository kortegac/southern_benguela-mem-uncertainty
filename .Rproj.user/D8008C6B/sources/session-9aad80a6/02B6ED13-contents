## Change between 1990-2009 and 2080-2099 

```{r deltas}
gtemp_delta <- g_temp |>
  group_by(scenario) |>
  mutate(start = year >= 1990 & year <= 2009, end = year >= 2080)  |>
  summarize(startB = mean(value_mean[start == 'TRUE'], na.rm = TRUE), startSD = sd(value_mean[start == 'TRUE'], na.rm = TRUE), endB = mean(value_mean[end == 'TRUE'], na.rm = TRUE), endSD = sd(value_mean[end == 'TRUE'], na.rm = TRUE))

itemp_delta <- i_temp |>
  group_by(scenario) |>
  mutate(start = year >= 1990 & year <= 2009, end = year >= 2080)  |>
  summarize(startB = mean(value_mean[start == 'TRUE'], na.rm = TRUE), startSD = sd(value_mean[start == 'TRUE'], na.rm = TRUE), endB = mean(value_mean[end == 'TRUE'], na.rm = TRUE), endSD = sd(value_mean[end == 'TRUE'], na.rm = TRUE))

gpp_delta <- g_pp |>
  group_by(scenario) |>
  mutate(start = year >= 1990 & year <= 2009, end = year >= 2080)  |>
  summarize(startB = mean(value_mean[start == 'TRUE'], na.rm = TRUE), startSD = sd(value_mean[start == 'TRUE'], na.rm = TRUE), endB = mean(value_mean[end == 'TRUE'], na.rm = TRUE), endSD = sd(value_mean[end == 'TRUE'], na.rm = TRUE))

ipp_delta <- i_pp |>
  group_by(scenario) |>
  mutate(start = year >= 1990 & year <= 2009, end = year >= 2080)  |>
  summarize(startB = mean(value_mean[start == 'TRUE'], na.rm = TRUE), startSD = sd(value_mean[start == 'TRUE'], na.rm = TRUE), endB = mean(value_mean[end == 'TRUE'], na.rm = TRUE), endSD = sd(value_mean[end == 'TRUE'], na.rm = TRUE))

# Saving the four summaries in one table
forcing_delta <- bind_rows(gtemp_delta |> mutate(esm = "gfdl", var = "temp"), itemp_delta |> mutate(esm = "ipsl", var = "temp"), gpp_delta |> mutate(esm = "gfdl", var = "intpp"), ipp_delta |> mutate(esm = "ipsl", var = "intpp"))

write_csv(forcing_delta, file.path(tableDir, "forcing_delta.csv"))
