## Read gfdl and ipsl datasets

```{r read}
gfdl_temp <- read_xlsx(file.path(forcingDir, "gfdl_CMIP6_timeseries.xlsx"), sheet = "temp")
gfdl_intpp <- read_xlsx(file.path(forcingDir, "gfdl_CMIP6_timeseries.xlsx"), sheet = "intpp")

ipsl_temp <- read_xlsx(file.path(forcingDir, "ipsl_CMIP6_timeseries.xlsx"), sheet = "temp")
ipsl_absintpp <- read_xlsx(file.path(forcingDir, "ipsl_CMIP6_timeseries.xlsx"), sheet = "intpp_abs")

#Combine gfdl and ipsl data into one dataset per variable
temp <- bind_cols(gfdl_temp[,c(1,8:10)], ipsl_temp[,c(8:10)])
intpp <- bind_cols(gfdl_intpp[,c(1:4)], ipsl_absintpp[,c(8:10)])

#Make column names more self-explanatory
colnames(temp) <- c("Time","pi_gfdl", "ssp1_gfdl","ssp5_gfdl", "pi_ipsl","ssp1_ipsl","ssp5_ipsl")
colnames(intpp) <- c("Time","pi_gfdl", "ssp1_gfdl","ssp5_gfdl", "pi_ipsl","ssp1_ipsl","ssp5_ipsl")

#Calculate annual average
temp <- temp |> filter(year(Time) <= 2099)
intpp <- intpp |> filter(year(Time) <= 2099)

temp_yavg <- temp  |> pivot_longer(!Time, names_to = "scenario", values_to = "value") |> mutate(year= year(Time)) |> group_by(year,scenario) |> summarise(value_mean = mean(value, na.rm = TRUE))
intpp_yavg <- intpp |> pivot_longer(!Time, names_to = "scenario", values_to = "value") |> mutate(year= year(Time)) |> group_by(year,scenario) |> summarise(value_mean = mean(value, na.rm = TRUE))
```

