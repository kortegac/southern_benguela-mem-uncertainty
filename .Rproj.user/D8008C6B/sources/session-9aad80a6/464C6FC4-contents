knitr::opts_chunk$set(echo = TRUE, message = FALSE, warning = FALSE)

library(tidyverse)
```

```{r paths}
# Paths relative to the project folder

outBfilepath <- "outputs/processed/B"
Bfilepath <- "data/raw/atlantis"
Bfilepath_E <- "data/raw/ewe"
year_EwE <- c(1978:2099)
year_atlantis <- c(1990:2099)

# Fished runs only 
scen <- c("pi_F_gfdl", "ssp126_F_gfdl", "ssp585_F_gfdl", "pi_F_ipsl", "ssp126_F_ipsl", "ssp585_F_ipsl")
